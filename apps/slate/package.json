{
  "name": "slate",
  "productName": "Slate",
  "version": "1.1.0",
  "description": "Accounts, retirement, credit cards, credit score and a monthly savings plan in one place.",
  "main": "src/main.js",
  "author": "Bilal",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "dist": "electron-builder --mac dir --arm64 && codesign --force --deep --sign - dist/mac-arm64/Slate.app && echo '\\n✅ Built dist/mac-arm64/Slate.app'",
    "install-app": "npm run dist && rm -rf /Applications/Slate.app && ditto dist/mac-arm64/Slate.app /Applications/Slate.app && echo '✅ Slate installed in /Applications'",
    "dist:win": "electron-builder --win portable zip --x64",
    "test:privacy": "node test/privacy.js"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.bilal.slate",
    "productName": "Slate",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "target": [
        "dir"
      ],
      "identity": null,
      "darkModeSupport": true
    },
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Slate-${version}-Windows-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Slate-${version}-Windows-Portable.${ext}"
    }
  }
}
