{
  "name": "onward",
  "productName": "Onward",
  "version": "0.2.1",
  "description": "Job hunting, tailored resumes and applications — with your AI plugged in.",
  "main": "src/main.js",
  "author": "Onward",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dir --arm64 && codesign --force --deep --sign - dist/mac-arm64/Onward.app && echo '\\n✅ Built dist/mac-arm64/Onward.app'",
    "install-app": "npm run dist && rm -rf /Applications/Onward.app && ditto dist/mac-arm64/Onward.app /Applications/Onward.app && echo '✅ Onward installed in /Applications'",
    "dist:win": "electron-builder --win nsis zip --x64"
  },
  "dependencies": {
    "docx": "^9.11.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.bilal.onward",
    "productName": "Onward",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "mcp/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "mcp/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        "dir"
      ],
      "identity": null,
      "darkModeSupport": true
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png",
      "artifactName": "Onward-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Onward",
      "artifactName": "Onward-Setup-${version}.${ext}"
    },
    "publish": null
  }
}
