{
  "name": "relay",
  "productName": "Relay",
  "version": "2.0.0",
  "description": "All your inboxes, calendars and AI in one place.",
  "main": "src/main.js",
  "author": "Bilal",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dir --arm64 && codesign --force --deep --sign - dist/mac-arm64/Relay.app && echo '\\n\u2705 Built dist/mac-arm64/Relay.app'",
    "install-app": "npm run dist && rm -rf /Applications/Relay.app && ditto dist/mac-arm64/Relay.app /Applications/Relay.app && echo '\u2705 Relay installed in /Applications'",
    "dist:win": "electron-builder --win portable zip --x64"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "@ghostery/adblocker-electron-preload": "^2.18.2",
    "castv2-client": "^1.2.0",
    "hls.js": "^1.7.3",
    "multicast-dns": "^7.2.5",
    "music-metadata": "^7.14.0",
    "node-ical": "^0.20.1",
    "pdfjs-dist": "^6.4.299",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.bilal.relay",
    "productName": "Relay",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        "dir"
      ],
      "identity": null,
      "darkModeSupport": true
    },
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Relay-${version}-Windows-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Relay-${version}-Windows-Portable.${ext}"
    }
  }
}
