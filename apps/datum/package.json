{
  "name": "datum",
  "version": "1.5.3",
  "description": "Datum — linked spreadsheets, slides, documents and dashboards in one workspace",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder"
  },
  "author": "Bilal",
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "chart.js": "^4.5.1",
    "docx": "^9.9.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "node-html-parser": "^9.0.4",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "Datum",
  "build": {
    "appId": "com.datum.workstation",
    "productName": "Datum",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "build/icon.png",
      "node_modules/**",
      "!node_modules/**/*.map",
      "!node_modules/**/test/**",
      "!node_modules/@napi-rs/**",
      "!node_modules/pdfjs-dist/legacy/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/types/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "fileAssociations": [
      {
        "ext": "datum",
        "name": "Datum Project",
        "role": "Editor"
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}