{
  "name": "beam",
  "productName": "Beam",
  "version": "0.1.1",
  "description": "Send files, folders, text and links straight to nearby Macs, PCs and phones on your network: no cloud, no cables, encrypted end to end and as fast as the network allows.",
  "main": "src/main.js",
  "author": "Bilal",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.bilal.beam",
    "productName": "Beam",
    "copyright": "Personal use",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "build/tray.png",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "darkModeSupport": true,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Beam finds your other computers and phones on this network and sends files straight to them.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Anything you can send",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.item",
              "public.folder"
            ]
          }
        ]
      }
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.png"
    }
  }
}
