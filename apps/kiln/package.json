{
  "name": "kiln",
  "productName": "Kiln",
  "version": "0.1.5",
  "description": "Install, run and create with Stable Diffusion apps — models, profiles, prompts and a built-in browser.",
  "main": "src/main.js",
  "author": "Bilal",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "@ghostery/adblocker-electron-preload": "^2.18.2"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.bilal.kiln",
    "productName": "Kiln",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "build/icon.png", "package.json"],
    "asarUnpack": [],
    "mac": { "target": ["dmg", "zip"], "icon": "build/icon.png", "category": "public.app-category.graphics-design" },
    "win": { "target": ["zip"], "icon": "build/icon.png", "signAndEditExecutable": false }
  }
}
