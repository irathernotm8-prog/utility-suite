{
  "name": "ro3",
  "productName": "RO3",
  "version": "1.2.2",
  "description": "RO3 (Rule of 3s) — photo editing, video editing and file conversion",
  "main": "main.js",
  "author": "Bilal",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/check-deps.js",
    "check": "node scripts/check-deps.js --strict",
    "predist:mac": "node scripts/check-deps.js --strict",
    "predist:win": "node scripts/check-deps.js --strict",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "test:engine": "node test/engine.test.js && node test/timeline2.test.js"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "ag-psd": "^31.0.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "imagetracerjs": "^1.2.6",
    "potrace": "^2.1.8",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.bilal.ro3",
    "productName": "RO3",
    "copyright": "Personal use",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "engine/**",
      "src/**",
      "build/icon.png",
      "package.json",
      "node_modules/**",
      "!test/**",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "darkModeSupport": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "RO3"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    },
    "fileAssociations": [
      {
        "ext": "ro3",
        "name": "RO3 Photo Project",
        "role": "Editor"
      },
      {
        "ext": "ro3v",
        "name": "RO3 Video Project",
        "role": "Editor"
      }
    ],
    "afterPack": "scripts/after-pack.js"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "0.35.5",
    "@img/sharp-darwin-x64": "0.35.5",
    "@img/sharp-libvips-darwin-arm64": "1.3.4",
    "@img/sharp-libvips-darwin-x64": "1.3.4",
    "@img/sharp-libvips-linux-x64": "1.3.4",
    "@img/sharp-linux-x64": "0.35.5",
    "@img/sharp-win32-arm64": "0.35.5",
    "@img/sharp-win32-x64": "0.35.5"
  }
}
