{
  "name": "lumen",
  "productName": "Lumen",
  "version": "0.4.0",
  "description": "Ads, analytics and a posting calendar in one calm place: Meta first (reporting, Facebook and Instagram posting), with optional Google and Salesforce, plus an AI you can ask with or without an API key.",
  "main": "src/main.js",
  "author": "Bilal",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.bilal.lumen",
    "productName": "Lumen",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    }
  }
}
