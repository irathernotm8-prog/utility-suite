{
  "name": "crate",
  "productName": "Crate",
  "version": "0.1.0",
  "description": "Download music from YouTube and more as MP3s, then tag, edit and organize them into albums before they go to your phone.",
  "main": "src/main.js",
  "author": "Bilal",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "node-id3": "^0.2.9"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.bilal.crate",
    "productName": "Crate",
    "copyright": "Personal use",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "node_modules/**",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "darkModeSupport": true
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    }
  }
}
