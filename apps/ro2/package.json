{
  "name": "ro2",
  "productName": "RO2",
  "version": "0.1.0",
  "description": "RO2: the quick, easy design and photo editor. Shapes, icons, text and photos, any size or aspect ratio, a background remover, a magic eraser and grab, and export to PNG, JPG, WebP, SVG and PDF.",
  "main": "src/main.js",
  "author": "Bilal",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "e2e": "bash test/e2e.sh",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.bilal.ro2",
    "productName": "RO2",
    "copyright": "Personal use",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!src/**/*.map"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "ro2",
        "name": "RO2 design",
        "role": "Editor",
        "icon": "build/icon.png"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design",
      "darkModeSupport": true
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.png"
    }
  }
}